# =============================================================================
# Switchboard — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# IMPORTANT — most operator-facing config (Anthropic key, SMTP, public URL)
# can now ALSO be set from the Settings page in the running app. That's the
# preferred way: open Settings → Anthropic (Claude) API, paste your key,
# click Save. The .env values here only act as fallbacks if the DB-stored
# value is empty.
#
# Only THREE values below are required to boot the app:
#   - APP_SECRET_KEY (random 32+ char string)
#   - DATABASE_URL   (Railway / Postgres provides this automatically)
#   - CORS_ORIGINS   (your web app's URL)
# Everything else can be set later through the Settings UI.
# =============================================================================

# --- REQUIRED -----------------------------------------------------------------

# Random 32+ character string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Used for JWT signing AND credential-vault encryption — DON'T change after
# you've stored any credentials (you won't be able to decrypt them).
APP_SECRET_KEY=change-me-generate-a-random-32-byte-string

# Postgres connection string. On Railway, this is auto-injected by the
# Postgres add-on; locally, SQLite works without anything installed:
#   DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql://localhost:5432/switchboard

# Comma-separated list of origins allowed to call the API.
# Production: include your public web URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OPTIONAL: can be set from Settings UI instead ----------------------------
# These all act as fallbacks; the Settings page overrides them.

ENVIRONMENT=development

# Anthropic Claude — required for agents to run. Get from console.anthropic.com.
# Set a monthly spend cap on Anthropic's side too.
ANTHROPIC_API_KEY=

# Default Claude model (per-agent overrides take precedence)
AGENT_MODEL=claude-opus-4-7
AGENT_EFFORT=high
AGENT_MAX_TOKENS=16000

# Best-effort SMTP notifications (emails the operator when an agent queues
# an approval). Empty = disabled; the in-app badge keeps working.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Public URL used in email bodies. e.g. https://switchboard.your-domain.com
APP_BASE_URL=

# Portal-integration backend. 'demo' is the deterministic in-process simulator
# (safe for dev / staging). When the Playwright integration is ready, set
# this to 'playwright' to hit real portals (still gated by approval queue).
PORTAL_INTEGRATION_BACKEND=demo

# --- OPTIONAL: storage --------------------------------------------------------

# Where uploaded documents are stored on disk. On Railway, mount a Volume to
# this path so files survive deploys. Production should eventually move to S3
# by swapping app/storage.py.
DOCUMENTS_DIR=.documents

# Optional dedicated key for vault encryption. If empty, falls back to
# APP_SECRET_KEY (which is fine for single-box deploys).
CREDENTIAL_ENC_KEY=
