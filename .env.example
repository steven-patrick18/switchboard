# =============================================================================
# Switchboard — Phase 1 environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Use TEST / SANDBOX keys during development.
# =============================================================================

# --- App ---
ENVIRONMENT=development
APP_SECRET_KEY=change-me-generate-a-random-32-byte-string

# --- Anthropic Claude (core — every agent runs on this) ---
# Get from https://console.anthropic.com — SET A MONTHLY SPEND CAP
ANTHROPIC_API_KEY=

# --- Database / cache (Railway provides these as env vars in prod) ---
DATABASE_URL=postgresql://localhost:5432/switchboard
REDIS_URL=redis://localhost:6379/0

# --- Telegram bot (approval queue) ---
# Create via @BotFather, token is regenerable if leaked
TELEGRAM_BOT_TOKEN=

# --- Gmail API (OAuth — use a throwaway test Google account in dev) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# --- DocuSign (use the free DEMO/developer account in dev) ---
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
# Path to the RSA private key file for JWT auth — keep OUT of git (see .gitignore)
DOCUSIGN_PRIVATE_KEY_PATH=./secrets/docusign_private.key

# --- Sentry (error tracking — free tier) ---
SENTRY_DSN=
