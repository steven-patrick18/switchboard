# =============================================================================
# Switchboard — Phase 1 environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Use TEST / SANDBOX keys during development.
# =============================================================================

# --- App ---
ENVIRONMENT=development
APP_SECRET_KEY=change-me-generate-a-random-32-byte-string

# --- Anthropic Claude (core — every agent runs on this) ---
# Get from https://console.anthropic.com — SET A MONTHLY SPEND CAP
ANTHROPIC_API_KEY=

# --- Database / cache (Railway provides these as env vars in prod) ---
DATABASE_URL=postgresql://localhost:5432/switchboard
REDIS_URL=redis://localhost:6379/0

# --- Telegram bot (approval queue) ---
# Create via @BotFather, token is regenerable if leaked
TELEGRAM_BOT_TOKEN=

# --- Gmail API (OAuth — use a throwaway test Google account in dev) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# --- SMTP notifications (optional; empty = disabled, in-app badge only) ---
# When set, the platform sends a best-effort email to the client's owning
# operator the moment an agent queues a tier-2/3 approval. Failures are
# logged but never block the agent loop.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Public URL used in notification email bodies (e.g. https://...).
APP_BASE_URL=

# --- E-signature: Documenso (self-hosted, open-source) ---
# Self-host the Documenso app so regulated client documents never transit
# a third-party SaaS. API auth is a Bearer token minted in the Documenso
# dashboard (Settings -> API Tokens). The self-host infra (Docker app +
# SMTP + signing cert) is stood up with the Week 4-5 e-sign integration.
ESIGN_PROVIDER=documenso
DOCUMENSO_API_URL=http://localhost:3001
DOCUMENSO_API_TOKEN=
DOCUMENSO_WEBHOOK_SECRET=

# --- Sentry (error tracking — free tier) ---
SENTRY_DSN=
