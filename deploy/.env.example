# Switchboard self-hosted deployment env.
# Copy to deploy/.env, fill in, then run deploy/install.sh.
# install.sh auto-generates POSTGRES_PASSWORD and APP_SECRET_KEY if blank.

# --- Domains -----------------------------------------------------------------
# Both must resolve to this VPS's public IP via DNS A records before
# Caddy can obtain Let's Encrypt certs.
API_DOMAIN=api.your-domain.com
WEB_DOMAIN=app.your-domain.com

# Email Let's Encrypt sends expiration warnings to. Real address.
ACME_EMAIL=ops@your-domain.com

# --- Secrets — auto-filled by install.sh if blank ---------------------------
# Postgres superuser password. Generated once and stored here so the DB
# volume keeps decrypting across restarts.
POSTGRES_PASSWORD=

# JWT signing + credential-vault encryption. NEVER rotate this after
# you've stored any credentials — they become un-decryptable.
APP_SECRET_KEY=

# --- Optional: app config (can also be set via Settings GUI) ----------------
# If left blank, the operator sets these from Settings → Anthropic
# (Claude) API after first login.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-4-7
